# The stand's front door: HTTPS for DOMAIN (Let's Encrypt), the platform's files, and /api to the gateway.
{$DOMAIN} {
	encode zstd gzip

	# The platform calls the gateway at /api; the gateway does not know the prefix.
	handle_path /api/* {
		reverse_proxy gateway:8787
	}

	handle {
		root * /srv
		# Built assets have content hashes in their names; the service worker and the page must not be cached.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh path /sw.js /index.html /
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
