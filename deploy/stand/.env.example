# Copy to deploy/stand/.env on the server (never commit it) and fill in. See docs/stand.md.

# The stand's address: an A record pointing at the server. Caddy gets the HTTPS certificate itself.
DOMAIN=app.example.ru
# A domain the school owns; it goes into every xAPI statement and must never change once students answer.
XAPI_BASE_IRI=https://example.ru

# Long random strings: openssl rand -hex 32
SESSION_SECRET=
ADMIN_TOKEN=
POSTGRES_PASSWORD=
LRS_SECRET=
LRS_ADMIN_PASSWORD=

# Yandex Object Storage: a private bucket and a static access key of a service account with storage.editor on it.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
