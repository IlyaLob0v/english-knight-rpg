{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.example.com/schemas/track.schema.json",
  "title": "Learning track",
  "description": "Module order, story chapters and the building each module unlocks. Reordering modules or reassigning a building is an edit of this file only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track_id", "title", "chapters"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "track_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "ru": { "type": "string", "minLength": 1 } }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter_id", "steps"],
        "properties": {
          "chapter_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "story_intro": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "story_id shown when the chapter opens" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["module_id", "quest_id", "unlocks_building"],
              "properties": {
                "module_id": { "type": "string" },
                "quest_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "unlocks_building": { "type": "string" },
                "boss": { "type": "string" },
                "intro": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "story_id shown before the step's first battle" },
                "outro": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "story_id shown after the boss is defeated" },
                "encounters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["enemies"],
                  "description": "Ordinary battles of the step. Tasks come from the module pool; the boss unlocks after wins_before_boss victories.",
                  "properties": {
                    "enemies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                    "wins_before_boss": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
