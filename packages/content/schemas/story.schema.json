{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.example.com/schemas/story.schema.json",
  "title": "Story scene",
  "description": "A dialogue shown between battles: a chapter intro, a quest intro or a victory outro. Tracks refer to it by story_id. Lines are in English with a Russian translation the player can reveal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "story_id", "lines"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "story_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "speaker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "ru"],
            "properties": { "en": { "type": "string", "minLength": 1 }, "ru": { "type": "string", "minLength": 1 } }
          },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "ru"],
            "properties": { "en": { "type": "string", "minLength": 1 }, "ru": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
