{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.example.com/schemas/enemies.schema.json",
  "title": "Enemies",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enemies"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enemy_id", "name", "sprite", "role", "hp", "damage"],
        "properties": {
          "enemy_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "ru"],
            "properties": { "en": { "type": "string", "minLength": 1 }, "ru": { "type": "string", "minLength": 1 } }
          },
          "sprite": { "type": "string", "minLength": 1 },
          "role": { "enum": ["minion", "elite", "boss"] },
          "hp": { "type": "integer", "minimum": 1 },
          "damage": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
