{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.example.com/schemas/buildings.schema.json",
  "title": "City buildings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "buildings"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["building_id", "name", "sprite", "cost_kp"],
        "properties": {
          "building_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "ru"],
            "properties": { "en": { "type": "string", "minLength": 1 }, "ru": { "type": "string", "minLength": 1 } }
          },
          "sprite": { "type": "string", "minLength": 1 },
          "cost_kp": { "type": "integer", "minimum": 0 },
          "bonus": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": { "enum": ["xp_multiplier", "hint_charges", "max_hp", "kp_multiplier"] },
              "value": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
