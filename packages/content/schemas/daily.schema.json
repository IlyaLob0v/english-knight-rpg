{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonbridge.example.com/schemas/daily.schema.json",
  "title": "Moonbridge daily loop",
  "description": "What the daily shift is made of: guests of the day (templates; their tasks come from units the student has passed) and the things that turn up in the lost-and-found (each stands for an error coming back on day 1, 3 or 7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "guests", "lost_items"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "2.0" },
    "guests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["guest_id", "name", "species", "arrival", "thanks", "disappointed", "teaser"],
        "properties": {
          "guest_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "species": { "$ref": "#/$defs/localized" },
          "portrait": { "type": "string", "pattern": "^[a-z0-9_/.-]+$", "description": "Art path; a stub until the illustrator delivers." },
          "host": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "The resident who meets the guest; must be a character." },
          "task_count": { "type": "integer", "minimum": 2, "maximum": 8, "default": 4 },
          "arrival": { "$ref": "#/$defs/line", "description": "What the guest says on arrival." },
          "thanks": { "$ref": "#/$defs/line", "description": "When most answers were right." },
          "disappointed": { "$ref": "#/$defs/line", "description": "When most were wrong: funny, never shaming." },
          "teaser": { "$ref": "#/$defs/line", "description": "Shown at the end of the day before this guest comes." }
        }
      }
    },
    "lost_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "name"],
        "properties": {
          "item_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "$ref": "#/$defs/localized" }
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "ru": { "type": "string", "minLength": 1 } }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "ru": { "type": "string", "minLength": 1 } }
    }
  }
}
