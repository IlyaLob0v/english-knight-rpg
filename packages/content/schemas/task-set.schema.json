{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonbridge.example.com/schemas/task-set.schema.json",
  "title": "Task set",
  "description": "All tasks of one unit. The engine knows only the task types; everything else here is data. Who says a task in Moonbridge is up to the episode, not the task.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_id", "tasks"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "2.0" },
    "module_id": { "type": "string", "pattern": "^(A1|A2|B1|B2|C1|C2)_[A-Za-z0-9]+_[0-9]{2}$" },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "concept_id", "type", "difficulty", "presentation", "answer"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^(A1|A2|B1|B2|C1|C2)_[A-Za-z0-9]+_[0-9]{2}_[a-z0-9_]+$" },
        "concept_id": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
        "type": { "enum": ["choice", "gap_fill", "transform", "order_words", "listen_type", "translate_ru_en", "translate_en_ru", "find_error"] },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "presentation": { "$ref": "#/$defs/presentation" },
        "answer": { "$ref": "#/$defs/answer" },
        "time_limit_s": { "type": "integer", "minimum": 3, "description": "Limit for timed mini-games; a slow answer also gets a lower recall rating." },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": { "properties": { "presentation": { "type": "object", "required": ["options"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "order_words" } } },
          "then": { "properties": { "presentation": { "type": "object", "required": ["tokens"] } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["transform", "translate_ru_en"] } } },
          "then": { "properties": { "presentation": { "type": "object", "required": ["source"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "listen_type" } } },
          "then": { "properties": { "presentation": { "type": "object", "required": ["audio"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "translate_en_ru" } } },
          "then": {
            "properties": {
              "presentation": { "type": "object", "required": ["source", "options"], "properties": { "options": { "type": "array", "minItems": 3, "maxItems": 3 } } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "find_error" } } },
          "then": {
            "properties": {
              "presentation": { "type": "object", "required": ["tokens"] },
              "answer": { "type": "object", "required": ["correction"], "properties": { "accepted": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+$" } } } }
            }
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "instruction_ru": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1, "description": "transform: the sentence to transform; translate_*: the sentence to translate" },
        "audio": { "type": "string", "pattern": "^[A-Za-z0-9_/.-]+\\.(mp3|m4a|ogg)$", "description": "listen_type: the recording the player types out" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "text": { "type": "string", "minLength": 1 } }
          }
        },
        "tokens": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": {
        "accepted": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "choice, translate_en_ru: option ids; find_error: the index of the wrong token, from 0; other types: accepted strings, compared after normalization"
        },
        "case_sensitive": { "type": "boolean", "default": false },
        "ignore_articles": {
          "type": "boolean",
          "description": "Accept an answer that differs from an accepted one only in a/an/the. Defaults to true for translate_ru_en and false otherwise."
        },
        "correction": { "type": "string", "minLength": 1, "description": "find_error: the right word, shown after the answer" },
        "known_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["match", "error_type"],
            "properties": {
              "match": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "error_type": { "type": "string" },
              "feedback": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
