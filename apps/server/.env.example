# Copy to .env (never commit it). Everything has a dev default except in production.
PORT=8787
PUBLIC_URL=http://localhost:8787
CLIENT_URL=http://localhost:5173
# Must be a domain you control; it is baked into every xAPI statement forever.
XAPI_BASE_IRI=https://moonbridge.example.com
# At least 32 characters. Required when NODE_ENV=production.
SESSION_SECRET=
# Enables PUT /content/source and POST /admin/teachers (creating teacher accounts).
ADMIN_TOKEN=
# Signed-in students and teachers stay signed in this long (default 30 days).
ACCOUNT_SESSION_TTL_SECONDS=2592000
# Homework files (default: data/uploads in the repository).
UPLOAD_DIR=
# Postgres for the gateway's state (LMS links, grades and xAPI queues, progress backups).
# Required when NODE_ENV=production; without it an in-memory Postgres (PGlite) is used and a restart forgets everything.
DATABASE_URL=
# LRS (xAPI). Without it statements stay queued.
LRS_ENDPOINT=
LRS_KEY=
LRS_SECRET=
# LTI 1.3: tool private key (PKCS#8 PEM) and the LMS registrations (JSON array of PlatformConfig).
# Each can come from a file instead: LTI_PRIVATE_KEY_FILE, LTI_PLATFORMS_FILE.
LTI_PRIVATE_KEY=
LTI_KEY_ID=moonbridge-tool-1
LTI_PLATFORMS=[]
