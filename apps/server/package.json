{
  "name": "@knight/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Integration gateway: Content API, xAPI outbox to LRS, LTI 1.3 tool (OIDC launch + AGS)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:lms": "tsx watch --env-file=../../docker/state/gateway.env src/main.ts",
    "start:lms": "tsx --env-file=../../docker/state/gateway.env src/main.ts",
    "lrs:errors": "tsx --env-file-if-exists=../../docker/state/gateway.env src/cli/lrs-errors.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@knight/content": "workspace:*",
    "@knight/xapi": "workspace:*",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/pg": "^8.23.1"
  }
}
