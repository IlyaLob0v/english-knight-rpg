  "story_id": "q_gatekeeper_intro",
  "lines": [
    {
      "speaker": {
        "en": "Elder Mara",
        "ru": "Старейшина Мара"
      },
      "text": {
        "en": "Rats live in the old gate now. A rusted sentinel guards it.",
        "ru": "В старых воротах теперь живут крысы. Их охраняет ржавый страж."
      }
    },
    {
      "speaker": {
        "en": "Knight",
        "ru": "Рыцарь"
      },
      "text": {
        "en": "I am not afraid. Where is the gate?",
        "ru": "Я не боюсь. Где ворота?"
      }
    }
  ]
}
