{
  "$schema": "../../packages/content/schemas/task-set.schema.json",
  "schema_version": "1.0",
  "module_id": "A1_VerbToBe_01",
  "tasks": [
    {
      "task_id": "A1_VerbToBe_01_q1",
      "concept_id": "verb_to_be.present_forms",
      "type": "gap_fill",
      "difficulty": 1,
      "presentation": {
        "speaker": "npc_gatekeeper",
        "prompt": "I ___ a knight of the Ruined Gate."
      },
      "answer": {
        "accepted": [
          "am"
        ],
        "known_errors": [
          {
            "match": [
              "is",
              "are"
            ],
            "error_type": "grammar.agreement",
            "feedback": "С I всегда am: I am"
          }
        ]
      },
      "combat": {
        "damage": 10,
        "time_limit_s": 25
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q2",
      "concept_id": "verb_to_be.present_forms",
      "type": "gap_fill",
      "difficulty": 1,
      "presentation": {
        "prompt": "The gate ___ old and broken."
      },
      "answer": {
        "accepted": [
          "is"
        ],
        "known_errors": [
          {
            "match": [
              "are",
              "am"
            ],
            "error_type": "grammar.agreement",
            "feedback": "The gate — это it, значит is"
          },
          {
            "match": [
              "be"
            ],
            "error_type": "grammar.tense_not_changed",
            "feedback": "be — начальная форма, нужна is"
          }
        ]
      },
      "combat": {
        "damage": 10,
        "time_limit_s": 25
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q3",
      "concept_id": "verb_to_be.present_forms",
      "type": "gap_fill",
      "difficulty": 1,
      "presentation": {
        "prompt": "The guards ___ asleep at their posts."
      },
      "answer": {
        "accepted": [
          "are"
        ],
        "known_errors": [
          {
            "match": [
              "is",
              "am"
            ],
            "error_type": "grammar.agreement",
            "feedback": "The guards — это they, значит are"
          }
        ]
      },
      "combat": {
        "damage": 10,
        "time_limit_s": 25
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q4",
      "concept_id": "verb_to_be.present_forms",
      "type": "choice",
      "difficulty": 1,
      "presentation": {
        "speaker": "npc_gatekeeper",
        "prompt": "You ___ brave, Sir Knight.",
        "options": [
          {
            "id": "a",
            "text": "is"
          },
          {
            "id": "b",
            "text": "are"
          },
          {
            "id": "c",
            "text": "am"
          }
        ]
      },
      "answer": {
        "accepted": [
          "b"
        ],
        "known_errors": [
          {
            "match": [
              "a",
              "c"
            ],
            "error_type": "grammar.agreement",
            "feedback": "С you всегда are"
          }
        ]
      },
      "combat": {
        "damage": 10,
        "time_limit_s": 25
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q5",
      "concept_id": "verb_to_be.negative",
      "type": "gap_fill",
      "difficulty": 1,
      "presentation": {
        "prompt": "The tower ___ safe. Rats live there! (negative)",
        "hint": "Отрицание: is + not"
      },
      "answer": {
        "accepted": [
          "is not",
          "isn't"
        ],
        "known_errors": [
          {
            "match": [
              "not is",
              "don't is",
              "doesn't"
            ],
            "error_type": "grammar.word_order",
            "feedback": "Отрицание: is + not → isn't"
          },
          {
            "match": [
              "aren't",
              "are not"
            ],
            "error_type": "grammar.agreement",
            "feedback": "The tower — it, значит isn't"
          }
        ]
      },
      "combat": {
        "damage": 10,
        "time_limit_s": 25
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q6",
      "concept_id": "verb_to_be.negative",
      "type": "transform",
      "difficulty": 2,
      "presentation": {
        "prompt": "Make the sentence negative.",
        "source": "We are afraid of the dark."
      },
      "answer": {
        "accepted": [
          "We are not afraid of the dark.",
          "We aren't afraid of the dark.",
          "We're not afraid of the dark."
        ],
        "known_errors": [
          {
            "match": [
              "We don't are afraid of the dark.",
              "We do not are afraid of the dark."
            ],
            "error_type": "grammar.auxiliary",
            "feedback": "С to be не нужен do: are not"
          },
          {
            "match": [
              "We not are afraid of the dark."
            ],
            "error_type": "grammar.word_order",
            "feedback": "not ставится после are"
          }
        ]
      },
      "combat": {
        "damage": 14,
        "time_limit_s": 40
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q7",
      "concept_id": "verb_to_be.questions",
      "type": "transform",
      "difficulty": 2,
      "presentation": {
        "prompt": "Make a question.",
        "source": "The blacksmith is at the forge."
      },
      "answer": {
        "accepted": [
          "Is the blacksmith at the forge?"
        ],
        "known_errors": [
          {
            "match": [
              "The blacksmith is at the forge?"
            ],
            "error_type": "grammar.word_order",
            "feedback": "В вопросе is выходит вперёд: Is the blacksmith…?"
          },
          {
            "match": [
              "Does the blacksmith is at the forge?",
              "Do the blacksmith is at the forge?"
            ],
            "error_type": "grammar.auxiliary",
            "feedback": "С to be не нужен do/does"
          }
        ]
      },
      "combat": {
        "damage": 14,
        "time_limit_s": 40
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q8",
      "concept_id": "verb_to_be.questions",
      "type": "order_words",
      "difficulty": 2,
      "presentation": {
        "prompt": "Build the gatekeeper's question.",
        "tokens": [
          "you",
          "Are",
          "a",
          "friend",
          "?"
        ]
      },
      "answer": {
        "accepted": [
          "Are you a friend?"
        ],
        "known_errors": [
          {
            "match": [
              "You are a friend?",
              "you are a friend"
            ],
            "error_type": "grammar.word_order",
            "feedback": "В вопросе are выходит вперёд"
          }
        ]
      },
      "combat": {
        "damage": 12,
        "time_limit_s": 40
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q9",
      "concept_id": "verb_to_be.questions",
      "type": "choice",
      "difficulty": 1,
      "presentation": {
        "prompt": "— ___ the rats dangerous? — Yes, they are.",
        "options": [
          {
            "id": "a",
            "text": "Is"
          },
          {
            "id": "b",
            "text": "Are"
          },
          {
            "id": "c",
            "text": "Do"
          }
        ]
      },
      "answer": {
        "accepted": [
          "b"
        ],
        "known_errors": [
          {
            "match": [
              "a"
            ],
            "error_type": "grammar.agreement",
            "feedback": "The rats — это they: Are"
          },
          {
            "match": [
              "c"
            ],
            "error_type": "grammar.auxiliary",
            "feedback": "С to be не нужен do"
          }
        ]
      },
      "combat": {
        "damage": 10,
        "time_limit_s": 25
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q10",
      "concept_id": "verb_to_be.negative",
      "type": "order_words",
      "difficulty": 2,
      "presentation": {
        "prompt": "Put the words in order.",
        "tokens": [
          "not",
          "I",
          "am",
          "a",
          "coward"
        ]
      },
      "answer": {
        "accepted": [
          "I am not a coward"
        ],
        "known_errors": [
          {
            "match": [
              "I not am a coward"
            ],
            "error_type": "grammar.word_order",
            "feedback": "not стоит после am"
          }
        ]
      },
      "combat": {
        "damage": 12,
        "time_limit_s": 40
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q11",
      "concept_id": "verb_to_be.present_forms",
      "type": "gap_fill",
      "difficulty": 2,
      "presentation": {
        "prompt": "My sword and shield ___ in the town hall."
      },
      "answer": {
        "accepted": [
          "are"
        ],
        "known_errors": [
          {
            "match": [
              "is"
            ],
            "error_type": "grammar.agreement",
            "feedback": "Две вещи (sword and shield) — they, значит are"
          }
        ]
      },
      "combat": {
        "damage": 10,
        "time_limit_s": 25
      }
    },
    {
      "task_id": "A1_VerbToBe_01_q12",
      "concept_id": "verb_to_be.questions",
      "type": "transform",
      "difficulty": 2,
      "presentation": {
        "prompt": "Make a question.",
        "source": "They are from the northern village."
      },
      "answer": {
        "accepted": [
          "Are they from the northern village?"
        ],
        "known_errors": [
          {
            "match": [
              "They are from the northern village?"
            ],
            "error_type": "grammar.word_order",
            "feedback": "Are выходит вперёд"
          },
          {
            "match": [
              "Do they are from the northern village?"
            ],
            "error_type": "grammar.auxiliary",
            "feedback": "С to be не нужен do"
          }
        ]
      },
      "combat": {
        "damage": 14,
        "time_limit_s": 40
      }
    }
  ]
}
