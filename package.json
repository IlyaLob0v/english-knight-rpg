{
  "name": "english-knight-rpg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "pnpm --filter @knight/content validate",
    "content:bundle": "pnpm --filter @knight/content bundle",
    "dev:server": "pnpm --filter @knight/server dev",
    "dev:client": "pnpm --filter @knight/client dev",
    "build:client": "pnpm --filter @knight/client build",
    "client:no-content": "pnpm --filter @knight/client check:no-content",
    "check": "pnpm typecheck && pnpm content:validate && pnpm client:no-content && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
