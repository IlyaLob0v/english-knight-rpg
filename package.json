{
  "name": "moonbridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "pnpm --filter @moonbridge/content validate",
    "content:bundle": "pnpm --filter @moonbridge/content bundle",
    "content:export": "pnpm --filter @moonbridge/content sheet:export",
    "content:import": "pnpm --filter @moonbridge/content sheet:import",
    "dev:server": "pnpm --filter @moonbridge/server dev",
    "dev:server:lms": "pnpm --filter @moonbridge/server dev:lms",
    "dev:web": "pnpm --filter @moonbridge/web dev",
    "build:web": "pnpm --filter @moonbridge/web build",
    "e2e": "pnpm build:web && pnpm --filter @moonbridge/e2e moonbridge && pnpm --filter @moonbridge/e2e school",
    "check": "pnpm typecheck && pnpm content:validate && pnpm test",
    "lms:up": "sh docker/setup.sh",
    "lms:down": "docker compose down",
    "lrs:errors": "pnpm --filter @moonbridge/server lrs:errors",
    "e2e:school": "pnpm build:web && pnpm --filter @moonbridge/e2e school"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
